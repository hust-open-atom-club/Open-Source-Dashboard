# Docker Compose environment for Open-Source-Dashboard
# Copy this file to the repository root as `.env` before running:
#   docker compose up -d --build

# Published ports on the Windows host
BACKEND_PORT=3000
FRONTEND_PORT=8080

# Container timezone
TZ=Asia/Shanghai

# GitHub Personal Access Token
# Required by the backend for GitHub API requests and secure git clone/pull.
# Use a PAT with the minimum scopes your organization data needs.
GITHUB_TOKEN=YOUR_GITHUB_PERSONAL_ACCESS_TOKEN
GITHUB_SIG_PROPERTY=osd_sig

# PostgreSQL bootstrap settings for the postgres container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_DB=oss_dashboard

# Backend startup behavior
# Keep both disabled for the first deployment unless you explicitly want
# startup-time cache flush or historical backfill.
ENABLE_STARTUP_CACHE_FLUSH=false
ENABLE_STARTUP_BACKFILL=false
STARTUP_BACKFILL_DAYS=30
